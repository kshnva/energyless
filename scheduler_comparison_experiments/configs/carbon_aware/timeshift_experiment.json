{
  "name": "timeshift_scheduler",
  "topologies": [
    {
      "pathToFile": "input/topologies/sample_NL_small.json"
    },
    {
      "pathToFile": "input/topologies/sample_BE_small.json"
    }
  ],
  "workloads": [
    {
      "pathToFile": "input/synthetic_traces/carbon_test_long_n120_edge_prob0.3_seed1_deadline_default",
      "type": "ComputeWorkload"
    }
  ],
  "allocationPolicies": [
    {
      "type": "timeshift",
      "filters": [
        {
          "type": "Compute"
        },
        {
          "type": "VCpu",
          "allocationRatio": 1.0
        },
        {
          "type": "Ram",
          "allocationRatio": 1.0
        }
      ],
      "weighers": [
        {
          "type": "Ram",
          "multiplier": 1.0
        }
      ],
      "windowSize": 168,
      "forecast": true,
      "shortForecastThreshold": 0.2,
      "longForecastThreshold": 0.35,
      "forecastSize": 24,
      "subsetSize": 1
    }
  ],
  "exportModels": [
    {
      "exportInterval": 3600,
      "printFrequency": 24,
      "filesToExport": ["host", "powerSource", "service", "task"]
    }
  ]
}
